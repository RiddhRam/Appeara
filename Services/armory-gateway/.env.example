# Provider credentials remain here or in your deployment secret store — never in Unity.
OPENAI_API_KEY=PASTE_OPENAI_KEY
ELEVENLABS_API_KEY=PASTE_ELEVENLABS_KEY
SENTRY_DSN=PASTE_SENTRY_DSN
SENTRY_ENVIRONMENT=demo
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
# Set this outside a private LAN and match it in AiSettings.GatewayToken.
ARMORY_GATEWAY_TOKEN=CHOOSE_A_LONG_RANDOM_VALUE
# Comma-separated deployed game origins. Keep * only for a local demo.
CORS_ORIGINS=*
